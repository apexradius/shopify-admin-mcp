{
  "name": "@apexradius/shopify-mcp",
  "version": "1.0.0",
  "description": "A Model Context Protocol (MCP) server for Shopify — giving Claude direct access to your store's products, orders, customers, collections, metafields, and themes.",
  "keywords": [
    "shopify",
    "mcp",
    "model-context-protocol",
    "claude",
    "anthropic",
    "ai",
    "ecommerce"
  ],
  "author": "Apex Radius",
  "license": "MIT",
  "homepage": "https://github.com/apexradius/shopify-admin-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/apexradius/shopify-admin-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/apexradius/shopify-admin-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "shopify-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1",
    "zod": "^4.3.6",
    "@apexradius/apex-mcp-shared": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4",
    "eslint-config-prettier": "^10.1.8",
    "@eslint/js": "^10.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
